# Copy this file to .env and fill in the real values for production
# Bot token (from @BotFather) - keep secret
BOT_TOKEN=5710729291:AAFGqwPv9w_6FFQ1a64TEHk8O4NqMY3-GbY

# Payment provider token (from your payment provider / Telegram Payments provider)
PAYMENT_PROVIDER_TOKEN=your_provider_token

# Optional: a client-side API key the webapp will send in X-API-Key header
CLIENT_API_KEY=some_shared_api_key_for_client

# Optional: Telegram chat ID that receives admin purchase notifications
# Example: ADMIN_CHAT_ID=123456789
ADMIN_CHAT_ID=

# Optional server port (defaults to 3001)
PORT=3001
